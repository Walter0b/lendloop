COMPOSE_PROJECT_NAME=lendloop-staging
# Set by CI on each release; make up uses this value
APP_IMAGE=ghcr.io/your-github-user/lendloop:replace-with-git-sha
APP_DOMAIN=staging.lendloop.example.com
# Distinct edge aliases so staging and production can share the edge network
APP_EDGE_ALIAS=lendloop-staging-app
N8N_EDGE_ALIAS=lendloop-staging-n8n
EDGE_NETWORK=edge-network-name
N8N_EDITOR_PORT=5679
TZ=UTC
# Per-environment Docker secret files (staging uses ./secrets/staging)
SECRETS_DIR=./secrets/staging

NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Use a separate Convex deployment and Clerk instance for staging
CLERK_JWT_ISSUER_DOMAIN=https://your-staging-instance.clerk.accounts.dev
LENDLOOP_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

POSTGRES_USER=n8n
POSTGRES_DB=n8n

# Pinned by digest. Bump the tag and digest together (docker buildx imagetools inspect <tag>)
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.47.7@sha256:b4b90747b81fcda7e76550c0d3aa7f0f64917a1e9573cff40d6834eaf2e0f8ea
POSTGRES_IMAGE=postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
REDIS_IMAGE=redis:7.4.5-alpine@sha256:bb186d083732f669da90be8b0f975a37812b15e913465bb14d845db72a4e3e08
