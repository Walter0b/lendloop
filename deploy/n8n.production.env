NODE_ENV=production
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=https://${APP_DOMAIN}/
N8N_EDITOR_BASE_URL=http://localhost:${N8N_EDITOR_PORT:-5678}/
N8N_PROXY_HOPS=1
# The editor is only reachable through an SSH tunnel to 127.0.0.1
N8N_SECURE_COOKIE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_ENCRYPTION_KEY_FILE=/run/secrets/n8n_encryption_key
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_METRICS=true
GENERIC_TIMEZONE=${TZ}
TZ=${TZ}

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=lendloop-postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD_FILE=/run/secrets/postgres_password

EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=lendloop-redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_HEALTH_CHECK_ACTIVE=true
QUEUE_HEALTH_CHECK_PORT=5678
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
CODE_ENABLE_STDOUT=true
LENDLOOP_WEBHOOK_SECRET=${LENDLOOP_WEBHOOK_SECRET}
CONVEX_SITE_URL=${CONVEX_SITE_URL}
